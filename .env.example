# Copy to .env on the server. Never commit .env. Never paste these values into a chat.

# REFLEX model (Claude Haiku 5.5)
ANTHROPIC_API_KEY=

# Exchange keys: only needed for `preview` and `live` modes.
# Create them with TRADE permission only, WITHDRAWALS OFF, and an IP allowlist of this server.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Live gate. Leave empty. Real orders are impossible unless mode=live AND this holds the exact
# phrase documented in docs/RUNBOOK.md AND the keys above exist.
TRADEBOT_LIVE_ACK=

# Optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
